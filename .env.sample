# Sample .env (do NOT store real secrets in version control)
# Copy this file to `.env` and fill in real values for local development.

# Plain-text trade password (preferred for local dev only)
MOOMOO_TRADE_PASSWORD=your_trade_password_here

# Alternatively, provide MD5 of the password instead of plaintext
# MOOMOO_TRADE_PASSWORD_MD5=abcdef1234567890abcdef1234567890

# Optional: security firm code used by TradeService
# MOOMOO_SECURITY_FIRM=FUTUSECURITIES
